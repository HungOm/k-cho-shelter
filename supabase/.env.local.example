# Copy this file to .env.local in the same directory and fill in the two values.
#
#   cp supabase/.env.local.example supabase/.env.local
#
# .env.local is gitignored. Never commit it, never paste the secret key into a
# chat, an issue, or a screenshot.

# Settings -> API -> Project URL. Safe to share; it is in the page source of
# every app that talks to this project.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Settings -> API -> Secret keys -> reveal. Starts sb_secret_
#
# THIS ONE IS NOT LIKE THE GOOGLE CLIENT ID. It bypasses every access rule in
# the database — row security, roles, the lot. Anyone holding it can read and
# change every buyer's name and phone number. It belongs on a server or in a
# file like this one, never in the browser bundle and never in the repository.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Settings -> API -> Publishable key. Starts sb_publishable_
#
# This one IS like the Google client id: public by design, meant to sit in the
# browser. It only reaches what row security allows. Not needed for the
# benchmark, but recorded here so the two are never confused.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# SELF-HOSTED? These three still apply, with your own values: the URL is your
# own domain (or http://kong:8000 from inside the stack), and the keys may be
# the older `service_role` / `anon` JWTs rather than sb_secret_ / sb_publishable_
# — the scripts treat them as opaque strings either way. backup.sh additionally
# wants SUPABASE_DB_URL, since there is no linked project to dump. The whole
# self-hosted path is supabase/SELF-HOST.md.
